# Server
PORT=5001
NODE_ENV=development

# Database (MongoDB Atlas). Leave unset to run in in-memory demo mode.
MONGO_URI=<your-mongodb-atlas-connection-string>

# Auth
JWT_SECRET=<your-jwt-secret>
JWT_EXPIRY=24h

# CORS / client origin (development only; production is same-origin)
CLIENT_URL=<your-local-client-url>
